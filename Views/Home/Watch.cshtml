@model WatchVideoViewModel
@using System.Security.Claims
@using Cinematron.Models
@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canHighlight = User.IsInRole("Admin") || currentUserId == Model.OwnerId;
}

<section class="watch-page">
    <a class="watch-back" asp-action="Videos">← Back to videos</a>
    <div class="watch-player-wrap">
        <video id="player" class="watch-player" controls playsinline preload="metadata" poster="@Model.PosterUrl">
            <source src="@Url.Content(Model.VideoUrl)" type="video/mp4" />
            Your browser does not support video playback.
        </video>
    </div>
    <div class="watch-details">
        <p class="eyebrow">NOW PLAYING</p>
        <div class="movie-meta"><span>@Model.Genre</span><span>@Model.OriginalFileName</span></div>
        <h1 class="watch-title">@Model.Title</h1>
        <p class="watch-description">@Model.Description</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="video-reactions" data-movie-id="@Model.Id">
                @foreach (var reaction in Enum.GetValues<VideoReactionType>())
                {
                    var label = reaction switch { VideoReactionType.Like => "Like", VideoReactionType.Dislike => "Dislike", VideoReactionType.Love => "Love", _ => "Hate" };
                    <button type="button" class="reaction-button @(Model.CurrentReaction == reaction ? "selected" : "")" data-reaction="@reaction">@label <span>@Model.ReactionCounts.GetValueOrDefault(reaction)</span></button>
                }
            </div>
        }
    </div>

    <section class="comments-section" aria-labelledby="commentsHeading">
        <h2 id="commentsHeading">Comments</h2>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form id="commentForm" asp-action="AddComment" asp-controller="Home" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="movieId" name="movieId" value="@Model.Id" />
                <textarea id="commentText" name="text" rows="3" placeholder="Add a comment..." maxlength="2000" required></textarea>
                <button id="submitComment" class="cinemátron-button" type="submit">Post comment</button>
            </form>
        }
        else
        {
            <p><a asp-area="Identity" asp-page="/Account/Login">Sign in</a> to post comments.</p>
        }

        <div id="commentsList">
            @foreach (var comment in Model.Comments)
            {
                <div class="comment @(comment.IsHighlighted ? "comment-highlighted" : "")" data-id="@comment.Id">
                    @if (comment.IsHighlighted) { <span class="highlight-label">Highlighted</span> }
                    <div class="comment-meta"><strong>@comment.UserName</strong> · <small>@comment.CreatedUtc.ToLocalTime().ToString("g")</small></div>
                    <div class="comment-text">@comment.Text</div>
                    @if (currentUserId == comment.UserId || canHighlight)
                    {
                        <div class="comment-actions">
                            @if (currentUserId == comment.UserId)
                            {
                                <button type="button" class="edit-comment" data-id="@comment.Id">Edit</button>
                                <button type="button" class="delete-comment" data-id="@comment.Id">Delete</button>
                            }
                            @if (canHighlight)
                            {
                                <button type="button" class="highlight-comment" data-id="@comment.Id">@(comment.IsHighlighted ? "Unhighlight" : "Highlight")</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('commentForm');
            const list = document.getElementById('commentsList');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const headers = { 'RequestVerificationToken': token, 'Accept': 'application/json' };
            const request = (url, values) => fetch(url, { method: 'POST', body: new URLSearchParams({ ...values, __RequestVerificationToken: token }), headers });
            const message = error => alert(error instanceof Error ? error.message : 'The operation could not be completed.');

            if (form) {
                form.addEventListener('submit', async event => {
                    event.preventDefault();
                    const textElement = document.getElementById('commentText');
                    const text = textElement.value.trim();
                    if (!text) return;
                    const submit = document.getElementById('submitComment');
                    submit.disabled = true;
                    try {
                        const response = await request('@Url.Action("AddComment", "Home")', { movieId: document.getElementById('movieId').value, text });
                        const data = await response.json().catch(() => ({}));
                        if (!response.ok) throw new Error(data.error || 'Could not post comment.');
                        const comment = document.createElement('div');
                        comment.className = 'comment';
                        comment.dataset.id = data.id;
                        comment.innerHTML = '<div class="comment-meta"><strong></strong> · <small></small></div><div class="comment-text"></div><div class="comment-actions"><button type="button" class="edit-comment" data-id="' + data.id + '">Edit</button><button type="button" class="delete-comment" data-id="' + data.id + '"></button></div>';
                        comment.querySelector('strong').textContent = data.userName;
                        comment.querySelector('small').textContent = new Date(data.createdUtc).toLocaleString();
                        comment.querySelector('.comment-text').textContent = data.text;
                        comment.querySelector('.delete-comment').textContent = 'Delete';
                        list.prepend(comment);
                        textElement.value = '';
                    } catch (error) { message(error); } finally { submit.disabled = false; }
                });
            }

            list?.addEventListener('click', async event => {
                const button = event.target.closest('button');
                if (!button) return;
                const comment = button.closest('.comment');
                const id = button.dataset.id;
                if (button.matches('.delete-comment')) {
                    if (!confirm('Are you sure you want to delete this comment?')) return;
                    try {
                        const response = await request('@Url.Action("DeleteComment", "Home")', { id });
                        const data = await response.json().catch(() => ({}));
                        if (!response.ok) throw new Error(data.error || 'Could not delete comment.');
                        comment.remove();
                    } catch (error) { message(error); }
                    return;
                }
                if (button.matches('.highlight-comment')) {
                    try {
                        const response = await request('@Url.Action("ToggleCommentHighlight", "Home")', { id });
                        const data = await response.json().catch(() => ({}));
                        if (!response.ok) throw new Error(data.error || 'Could not update comment highlight.');
                        button.textContent = data.isHighlighted ? 'Unhighlight' : 'Highlight';
                        comment.classList.toggle('comment-highlighted', data.isHighlighted);
                        const label = comment.querySelector('.highlight-label');
                        if (data.isHighlighted && !label) comment.insertAdjacentHTML('afterbegin', '<span class="highlight-label">Highlighted</span>');
                        if (!data.isHighlighted) label?.remove();
                    } catch (error) { message(error); }
                    return;
                }
                if (button.matches('.edit-comment')) {
                    const textNode = comment.querySelector('.comment-text');
                    const original = textNode.textContent;
                    const editor = document.createElement('textarea');
                    editor.className = 'edit-textarea'; editor.maxLength = 2000; editor.value = original;
                    const save = document.createElement('button'); save.type = 'button'; save.className = 'cinemátron-button'; save.textContent = 'Save';
                    const cancel = document.createElement('button'); cancel.type = 'button'; cancel.className = 'cinemátron-button'; cancel.textContent = 'Cancel';
                    textNode.replaceWith(editor); button.hidden = true; comment.querySelector('.delete-comment')?.setAttribute('hidden', 'hidden'); comment.append(save, cancel);
                    save.addEventListener('click', async () => {
                        const text = editor.value.trim(); if (!text) return;
                        try {
                            const response = await request('@Url.Action("EditComment", "Home")', { id, text });
                            const data = await response.json().catch(() => ({}));
                            if (!response.ok) throw new Error(data.error || 'Could not edit comment.');
                            const replacement = document.createElement('div'); replacement.className = 'comment-text'; replacement.textContent = text;
                            editor.replaceWith(replacement); save.remove(); cancel.remove(); button.hidden = false; comment.querySelector('.delete-comment')?.removeAttribute('hidden');
                        } catch (error) { message(error); }
                    });
                    cancel.addEventListener('click', () => { editor.replaceWith(textNode); save.remove(); cancel.remove(); button.hidden = false; comment.querySelector('.delete-comment')?.removeAttribute('hidden'); });
                }
            });

            document.querySelector('.video-reactions')?.addEventListener('click', async event => {
                const button = event.target.closest('.reaction-button');
                if (!button) return;
                const reactions = button.closest('.video-reactions');
                try {
                    const response = await request('@Url.Action("SetVideoReaction", "Home")', { movieId: reactions.dataset.movieId, type: button.dataset.reaction });
                    const data = await response.json().catch(() => ({}));
                    if (!response.ok) throw new Error(data.error || 'Could not save reaction.');
                    reactions.querySelectorAll('.reaction-button').forEach(item => {
                        item.classList.toggle('selected', data.currentReaction === item.dataset.reaction);
                        item.querySelector('span').textContent = data.counts[item.dataset.reaction] ?? 0;
                    });
                } catch (error) { message(error); }
            });
        })();
    </script>
}
