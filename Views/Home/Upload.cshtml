@model UploadVideoViewModel
@{ ViewData["Title"] = "Upload"; }
<section class="upload-page"><div class="upload-heading"><p class="eyebrow">CINEMATRON STUDIO</p><h1>Upload a movie</h1><p>Add a new story to your Cinematron collection.</p></div>@if (TempData["UploadMessage"] is string message) { <div class="upload-success" role="status">@message</div> }<form class="upload-form" asp-action="Upload" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="upload-validation"></div><div class="upload-fields"><div class="upload-field"><label asp-for="Title"></label><input asp-for="Title" placeholder="Enter the movie title" /><span asp-validation-for="Title"></span></div><div class="upload-field"><label asp-for="Genre"></label><input asp-for="Genre" placeholder="Drama, action, comedy..." /><span asp-validation-for="Genre"></span></div><div class="upload-field upload-field-wide"><label asp-for="Description"></label><textarea asp-for="Description" rows="5" placeholder="Tell viewers what this movie is about"></textarea><span asp-validation-for="Description"></span></div><div class="upload-field"><label asp-for="VideoFile"></label><input asp-for="VideoFile" type="file" accept=".mp4,.webm,.mov,video/*" /><small>Required. MP4, WebM, or MOV, maximum 500 MB.</small><span asp-validation-for="VideoFile"></span></div><div class="upload-field"><label asp-for="PosterFile"></label><input asp-for="PosterFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/*" /><small>Optional. JPG, PNG, or WebP, maximum 5 MB.</small><span asp-validation-for="PosterFile"></span></div></div><div class="upload-actions"><a class="upload-cancel" asp-action="Index">Cancel</a><button class="cinemátron-button" type="submit">Upload movie <span>→</span></button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }