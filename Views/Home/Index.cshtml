@model HomeContentViewModel
@{ ViewData["Title"] = "Home"; var search = ViewData["Search"] as string; var welcomeName = User.Identity?.IsAuthenticated == true ? (User.Identity.Name ?? "User") : "Guest"; }
<div class="welcome-banner" role="status">Welcome, @welcomeName | @DateTime.Now.ToString("g")</div>
<section class="home-content-grid home-content-top" aria-label="Cinematron extras">
    <article class="content-panel jokes-panel"><p class="eyebrow">FOR A QUICK SMILE</p><h2>Jokes</h2>@foreach (var joke in Model.Jokes) { <div class="joke-card"><p>“@joke.Text”</p>@if (!string.IsNullOrWhiteSpace(joke.Author)) { <small>— @joke.Author</small> }</div> }</article>
    <article class="content-panel news-panel"><p class="eyebrow">FROM THE MOVIE WORLD</p><h2>News</h2>@foreach (var item in Model.News) { <article class="news-card"><h3>@item.Headline</h3><p>@item.Summary</p><small>@item.Source · @item.PublishedUtc.ToLocalTime().ToString("d")</small></article> }</article>
</section>
<section class="cinemátron-hero"><div class="hero-copy"><p class="eyebrow">YOUR PERSONAL MOVIE LIBRARY</p><h1>Stories worth<br /><span>watching.</span></h1><p class="hero-description">Discover new worlds, unforgettable characters, and the films everyone is talking about.</p><a class="cinemátron-button" href="#new-releases">Explore movies <span>→</span></a></div><div class="hero-reel" aria-hidden="true"><span>▶</span></div></section>
<section class="commercial-banners" aria-label="Cinematron tools"><article class="commercial-banner"><span class="commercial-label">FUTURE PARTNER SPOTLIGHT</span><h2>Your next great story could be here.</h2><p>A premium space reserved for future Cinematron partners and movie promotions.</p><span class="commercial-placeholder">AD SPACE</span></article><article class="commercial-banner memo-translator"><span class="commercial-label">MEMO TRANSLATOR</span><h2>Turn your late-night thoughts into clear words.</h2><p>Write your message below and let Cinematron give it a playful, readable translation.</p><textarea id="memoInput" rows="3" placeholder="Type your memo here..."></textarea><button id="translateMemo" class="cinemátron-button" type="button">Translate memo <span>→</span></button><output id="memoOutput" class="memo-output" aria-live="polite"></output></article></section>
<section id="new-releases" class="movie-section"><div class="section-heading"><div><p class="eyebrow">CINEMATRON COLLECTION</p><h2>New videos</h2></div>@if (!string.IsNullOrWhiteSpace(search)) { <p class="search-result">Results for <strong>“@search”</strong></p> }</div>
@if (Model.Movies.Any()) { <div class="movie-grid">@foreach (var movie in Model.Movies) { <article class="movie-card"><div class="poster-wrap"><img src="@movie.PosterUrl" alt="Poster for @movie.Title" loading="lazy" />@if (movie.Id.HasValue && !string.IsNullOrWhiteSpace(movie.VideoUrl)) { <a class="play-button" asp-action="Watch" asp-route-id="@movie.Id" aria-label="Play @movie.Title">▶<span>Play</span></a><video class="duration-source" data-duration-target="duration-@movie.Id" preload="metadata" src="@Url.Content(movie.VideoUrl)"></video> }</div><div class="movie-details"><div class="movie-meta"><span>@movie.Genre</span><span>@movie.Year</span></div>@if (movie.Id.HasValue && !string.IsNullOrWhiteSpace(movie.VideoUrl)) { <h3><a class="movie-title-link" asp-action="Watch" asp-route-id="@movie.Id">@movie.Title</a></h3> } else { <h3>@movie.Title</h3> }<p>@movie.Description</p><div class="movie-footer"><span class="runtime" id="duration-@movie.Id">@movie.Runtime</span><span class="movie-author">By @movie.Author</span></div></div></article> }</div> } else { <div class="empty-state">No movies matched your search.</div> }</section>
<section id="about" class="about-strip"><p class="eyebrow">ABOUT CINEMATRON</p><h2>Made for movie people.</h2><p>Keep your favorite stories in one place and find your next great watch.</p></section>
@section Scripts { <script>document.querySelectorAll('.duration-source').forEach(video => video.addEventListener('loadedmetadata', () => { const target = document.getElementById(video.dataset.durationTarget); if (!target || !Number.isFinite(video.duration)) return; const total = Math.round(video.duration); target.textContent = `${Math.floor(total / 3600).toString().padStart(2, '0')}:${Math.floor((total % 3600) / 60).toString().padStart(2, '0')}:${(total % 60).toString().padStart(2, '0')}`; })); const memoInput = document.getElementById('memoInput'); const memoOutput = document.getElementById('memoOutput'); document.getElementById('translateMemo')?.addEventListener('click', () => { const text = memoInput.value.trim(); memoOutput.textContent = text ? `Clear version: “${text}” — honest, just a little more organized.` : 'Write something first and I will translate it.'; });</script> }
