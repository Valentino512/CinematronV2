@page
@model Cinematron.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<section class="auth-page">
    <div class="auth-card">
        <h2>Sign in</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="upload-validation" role="alert"></div>

            <div class="auth-field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="email" />
                <span asp-validation-for="Input.Email"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password"></span>
            </div>

            <div class="auth-field">
                <input asp-for="Input.RememberMe" /> <label asp-for="Input.RememberMe"></label>
            </div>

            <button class="cinemátron-button auth-submit" type="submit">Sign in</button>
        </form>
        <p class="auth-footer">Don't have an account? <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
